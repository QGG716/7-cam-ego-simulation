    def "WorkerAppearance"
    {
        def Material "vest"
        {
            token outputs:surface.connect = </World/WorkerAppearance/vest/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.31, 0.025)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "workpants"
        {
            token outputs:surface.connect = </World/WorkerAppearance/workpants/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.025, 0.065, 0.12)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "tshirt"
        {
            token outputs:surface.connect = </World/WorkerAppearance/tshirt/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.14, 0.22)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "boots"
        {
            token outputs:surface.connect = </World/WorkerAppearance/boots/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.035, 0.035, 0.04)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "gloves"
        {
            token outputs:surface.connect = </World/WorkerAppearance/gloves/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.3, 0.32, 0.34)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "hardhat"
        {
            token outputs:surface.connect = </World/WorkerAppearance/hardhat/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.69, 0.025)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "reflective"
        {
            token outputs:surface.connect = </World/WorkerAppearance/reflective/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.74, 0.77, 0.8)
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }
    }

    over "Person"
    {
        over "ManRoot"
        {
            over "male_adult_construction_01"
            {
                over "male_adult_construction_01"
                {
                    over "opaque__fabric__vest_01" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </World/WorkerAppearance/vest> (
                            bindMaterialAs = "strongerThanDescendants"
                        )
                    }

                    over "opaque__plastic__hardhat_01" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </World/WorkerAppearance/hardhat> (
                            bindMaterialAs = "strongerThanDescendants"
                        )
                    }

                    over "opaque__fabric__workpants_01" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </World/WorkerAppearance/workpants> (
                            bindMaterialAs = "strongerThanDescendants"
                        )
                    }

                    over "opaque__leather__boots_01" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </World/WorkerAppearance/boots> (
                            bindMaterialAs = "strongerThanDescendants"
                        )
                    }

                    over "opaque__leather__gloves_01" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </World/WorkerAppearance/gloves> (
                            bindMaterialAs = "strongerThanDescendants"
                        )
                    }

                    over "opaque__fabric__tshirt_01" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </World/WorkerAppearance/tshirt> (
                            bindMaterialAs = "strongerThanDescendants"
                        )
                    }

                    over "retro__reflective__vest_01" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </World/WorkerAppearance/reflective> (
                            bindMaterialAs = "strongerThanDescendants"
                        )
                    }

                    over "retro__reflective__pants_01" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </World/WorkerAppearance/reflective> (
                            bindMaterialAs = "strongerThanDescendants"
                        )
                    }
                }
            }
        }
    }
}
